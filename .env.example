# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_password

# RabbitMQ Configuration
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=your_rabbitmq_user
RABBITMQ__PASSWORD=your_rabbitmq_password
RABBITMQ__VIRTUALHOST=/

# JWT Configuration - Generate a new secure key for production!
JWT__KEY=your_jwt_secret_key_minimum_32_characters_long_and_secure
JWT__ISSUER=your-app-name
JWT__AUDIENCE=your-client-name
JWT__EXPIRESINMINUTES=60
